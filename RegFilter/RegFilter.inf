; RegFilter.inf


[Version]
Signature   = "$Windows NT$"
Class       = System
ClassGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %sifps%
DriverVer   = 12/12/2025,1.0.0.0
CatalogFile = RegFilter.cat


; General Installation


[DefaultInstall]
CopyFiles = DriverCopy

[DefaultInstall.Services]
AddService = RegFilter, 0x00000002, RegFilter.Service

[DestinationDirs]
DriverCopy = 12  

[DriverCopy]
RegFilter.sys

; Service Definition


[RegFilter.Service]
DisplayName    = %service_desc%
ServiceType    = 1            ; SERVICE_KERNEL_DRIVER
StartType      = 0            ; Boot Start (SERVICE_BOOT_START)
ErrorControl   = 3            ; Critical
ServiceBinary  = %12%\RegFilter.sys
LoadOrderGroup = "Base"       


; Localizable Strings


[Strings]
sifps        = "SIFPS"
service_desc = "Registry Protection Filter Driver"
